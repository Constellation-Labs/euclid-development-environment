{
  "name": "euclid-development-environment",
  "version": "2.0.0",
  "description": "Hydra CLI — build, run, and deploy Constellation Network metagraphs locally and remotely",
  "type": "module",
  "bin": {
    "hydra": "./dist/cli/index.js",
    "euclid": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "hydra": "node --enable-source-maps ./dist/cli/index.js",
    "postinstall": "npm run build 2>/dev/null || true"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "dockerode": "^4.0.0",
    "zod": "^3.24.0",
    "ora": "^8.2.0",
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.0",
    "@inquirer/prompts": "^7.0.0",
    "node-ssh": "^13.0.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0"
}
